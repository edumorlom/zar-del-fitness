# Copy this file to .env and fill it in.

# --- OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# gpt-realtime-2.1-mini is cheaper and usually good enough for answering questions.
# Voices: marin, cedar, alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_VOICE=marin
# Optional, only for reasoning-capable models (e.g. gpt-realtime-2): minimal, low, medium, high.
# Lower means faster replies. Leave blank to use the model's default.
OPENAI_REASONING_EFFORT=
# Printed by `python upload_knowledge.py` the first time you run it.
VECTOR_STORE_ID=

# --- Twilio (Console > Account Info > Account SID and Auth Token)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
# Public HTTPS address of this server. While developing, your ngrok URL.
# On Railway, leave it out: the server uses the domain Railway generates.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Transfers and booking confirmations (see "Transfers and WhatsApp" in the README)
# Where calls are transferred when the caller asks for Ronald.
RONALD_PHONE=+17867154286
# Where booking confirmations are sent by WhatsApp.
BOOKINGS_WHATSAPP_TO=+17867154286
# WhatsApp number that sends them. Twilio's sandbox is +14155238886.
TWILIO_WHATSAPP_FROM=+14155238886
# Optional: Content SID (HX...) of an approved WhatsApp template. Needed outside the sandbox.
TWILIO_WHATSAPP_TEMPLATE_SID=

# --- Business
BUSINESS_NAME=Zar del Fitness
GREETING=¡Hola! Gracias por llamar a Zar del Fitness. ¿En qué te puedo ayudar?
