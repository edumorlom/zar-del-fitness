# Copy this file to .env and fill it in.

# --- OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# gpt-realtime-2.1 is the larger model: smarter, but slower and more expensive.
# Voices: cedar (male) and marin (female) sound the most natural. Others: alloy, ash, ballad, coral, echo, sage, shimmer, verse
OPENAI_VOICE=cedar
# Optional, only for reasoning-capable models (e.g. gpt-realtime-2): minimal, low, medium, high.
# Lower means faster replies. Leave blank to use the model's default.
OPENAI_REASONING_EFFORT=

# --- Twilio (Console > Account Info > Account SID and Auth Token)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
# Public HTTPS address of this server. While developing, your ngrok URL.
# On Railway, leave it out: the server uses the domain Railway generates.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Transfers and booking emails (see "Transfers and booking emails" in the README)
# Where calls are transferred: the front desk advisors.
FRONT_DESK_PHONE=+5491127336258
# Resend (resend.com > API Keys) emails each booking to BOOKINGS_EMAIL_TO.
RESEND_API_KEY=re_...
BOOKINGS_EMAIL_TO=zardelfitnessgym@gmail.com
# Any address on a domain verified in Resend.
BOOKINGS_EMAIL_FROM=Asistente Zar del Fitness <asistente@edumorales.dev>

# --- Business
BUSINESS_NAME=Zar del Fitness
GREETING=¡Hola! Gracias por llamar a Zar del Fitness. ¿En qué te puedo ayudar?
