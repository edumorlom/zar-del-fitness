# Copy this file to .env and fill it in.

# --- OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
# The voice model, which talks with the caller (GPT-Live).
OPENAI_LIVE_MODEL=gpt-live-1
# Voices: cedar (male) and marin (female) sound the most natural. Others: alloy, ash, ballad, beacon, bossa,
# cinder, coral, delta, echo, gleam, meridian, quartz, ripple, sage, shimmer, stone, tempo, verse, vesper, willow
OPENAI_VOICE=cedar
# The backend model, which transfers calls and books visits when the voice model delegates them.
# gpt-6-sol is smarter, but slower and more expensive.
OPENAI_BACKEND_MODEL=gpt-6-luna
# Optional reasoning effort for the backend model: none, minimal, low, medium, high (depending on the model).
# Lower means faster bookings and transfers. Leave blank to use the model's default.
OPENAI_REASONING_EFFORT=

# --- Twilio (Console > Account Info > Account SID and Auth Token)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
# Public HTTPS address of this server. While developing, your ngrok URL.
# On Railway, leave it out: the server uses the domain Railway generates.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# --- Transfers and booking emails (see "Transfers and booking emails" in the README)
# Where calls are transferred: the front desk advisors.
FRONT_DESK_PHONE=+5491127336258
# Resend (resend.com > API Keys) emails each booking to BOOKINGS_EMAIL_TO.
RESEND_API_KEY=re_...
BOOKINGS_EMAIL_TO=zardelfitnessgym@gmail.com
# Any address on a domain verified in Resend.
BOOKINGS_EMAIL_FROM=Asistente Zar del Fitness <asistente@edumorales.dev>

# --- Business
BUSINESS_NAME=Zar del Fitness
GREETING=¡Hola! Gracias por llamar a Zar del Fitness. ¿En qué te puedo ayudar?
