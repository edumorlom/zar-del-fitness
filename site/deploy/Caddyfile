# El sitio en Railway: sirve site/out/ (el build estático) con las mismas reglas que tenía public/.htaccess en cPanel.
# Railway pone el HTTPS y el puerto ($PORT).
{
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	# En orden, como en .htaccess: la primera regla que coincide gana.
	route {
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		}

		# El .com y los www van al dominio principal, con la misma ruta
		@com host zardelfitness.com www.zardelfitness.com
		redir @com https://zardelfitness.com.ar{uri} 301
		@www header_regexp www Host ^www\.(.+)$
		redir @www https://{re.www.1}{uri} 301

		# URLs viejas del WordPress
		@es path_regexp es ^/(?:es|spanish)(?:/(.*))?$
		redir @es /{re.es.1}{?query} 301
		@english path_regexp english ^/english(?:/(.*))?$
		redir @english /en/{re.english.1}{?query} 301
		@index path_regexp index ^(.*/)index\.html$
		redir @index {re.index.1}{?query} 301
		@programas path_regexp ^/(servicios|entrenamiento-online|entrenamiento-presencial|sistema-general-dirigido|producto/reto-de-los-25-dias-(online|presencial))/?$
		redir @programas /#programas 301
		@zar path_regexp ^/(sobre-ronald|entrenadores)/?$
		redir @zar /#zar 301
		@resultados path_regexp ^/transformaciones-(online|presencial)/?$
		redir @resultados /#resultados 301
		@blogpage path_regexp blogpage ^/(en/)?blog/page/[0-9]+/?$
		redir @blogpage /{re.blogpage.1}blog/ 301
		@sitemaps path /sitemap /sitemap/ /sitemap.xml/ /sitemap.html /sitemap_index.xml /wp-sitemap.xml /post-sitemap.xml /page-sitemap.xml /product-sitemap.xml /category-sitemap.xml
		redir @sitemaps /sitemap.xml 301

		# Lo que ya no existe (la tienda, WordPress, los archivos por fecha, dos notas borradas): 410, para que Google
		# lo saque rápido.
		@gone path_regexp ^/((tienda|carrito|checkout|finalizar-compra|mi-cuenta|producto|product|categoria-producto|product-category|guia-de-entrenadores|guia-de-gimnasios|category|tag|author|feed|comments|wp-admin|wp-content|wp-includes|wp-json)(/.*)?|(wp-login|xmlrpc|wp-cron)\.php|(en/)?[0-9]{4}(/[0-9]{2}(/[0-9]{2})?)?/?|(en/)?[0-9]{4}/[0-9]{2}/[0-9]{2}/[^/]+/(feed|amp)/?|2021/01/04/que-son-los-quemadores-de-grasa/?|en/2021/01/04/what-are-fat-burners/?)$
		error @gone 410

		# Una carpeta sin la barra final (/blog), a la URL con barra: 301 como Apache (Caddy solo haría 308).
		@folder {
			not path */
			file {path}/index.html
		}
		redir @folder {path}/{?query} 301

		# Caché (lo que no es redirección): el HTML siempre fresco; JS, CSS y fuentes (con hash en el nombre) un año;
		# imágenes una semana; lo demás una hora.
		header Cache-Control "public, max-age=3600"
		@html path / */ *.html
		header @html Cache-Control "public, max-age=0"
		@year path *.js *.css *.woff2
		header @year Cache-Control "public, max-age=31536000"
		@week path *.webp *.jpg *.jpeg *.png *.svg *.ico
		header @week Cache-Control "public, max-age=604800"

		# Tipos que Caddy no adivina: los archivos sin extensión que genera Next.js, el manifest y el sitemap
		@og path_regexp /opengraph-image(-[a-z0-9]+)?$
		header @og {
			Content-Type image/jpeg
			Cache-Control "public, max-age=604800"
		}
		@appleicon path /apple-icon
		header @appleicon {
			Content-Type image/png
			Cache-Control "public, max-age=604800"
		}
		@manifest path *.webmanifest
		header @manifest Content-Type "application/manifest+json"
		@xml path *.xml
		header @xml Content-Type "application/xml"

		file_server
	}

	# 404 y 410 muestran la página 404 del sitio, con su código
	handle_errors {
		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "SAMEORIGIN"
			Referrer-Policy "strict-origin-when-cross-origin"
			Cache-Control "max-age=0"
		}
		rewrite * /404.html
		file_server {
			status {err.status_code}
		}
	}
}
