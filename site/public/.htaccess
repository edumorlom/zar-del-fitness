# Apache / cPanel config for the static export (copied into out/ on build)

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# No directory listings (e.g. /2026/10/, which only holds blog post folders).
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # zardelfitness.com (with or without www) is a second address for the same site: it goes to the same page on
  # .com.ar in one hop. Its certificate is on the same cPanel account (AutoSSL), so https://zardelfitness.com works too.
  RewriteCond %{HTTP_HOST} ^(www\.)?zardelfitness\.com$ [NC]
  RewriteRule ^ https://zardelfitness.com.ar%{REQUEST_URI} [R=301,L]

  # One version of the site for Google: without www (http → https is already done by the host).
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # Languages: Spanish is at the root and English under /en/. /es/ (and anything under it) goes to the same page
  # without the prefix: /es/blog/ → /blog/. /spanish/ and /english/ were the prefixes for a few hours on 2026-10-11.
  RewriteRule ^(?:es|spanish)(?:/(.*))?$ /$1 [R=301,L]
  RewriteRule ^english(?:/(.*))?$ /en/$1 [R=301,L]

  # /index.html and /blog/index.html → / and /blog/
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.html[\s?]
  RewriteRule ^ /%1 [R=301,L]

  # --- Old WordPress site (until 2026-10-10) ---
  # The site is one page plus the blog. The blog posts and /blog/ kept their old URLs; old pages
  # whose content is now a section of the home page go to that section.
  RewriteRule ^(servicios|entrenamiento-online|entrenamiento-presencial|sistema-general-dirigido|producto/reto-de-los-25-dias-(online|presencial))/?$ /#programas [NE,R=301,L]
  RewriteRule ^(sobre-ronald|entrenadores)/?$ /#zar [NE,R=301,L]
  RewriteRule ^transformaciones-(online|presencial)/?$ /#resultados [NE,R=301,L]
  RewriteRule ^blog/page/[0-9]+/?$ /blog/ [R=301,L]

  # The sitemap is /sitemap.xml. The old WordPress sitemaps (maybe still registered in Search Console)
  # and the address typed without ".xml" or with a trailing slash go there.
  RewriteCond %{REQUEST_URI} ^/(sitemap/?|sitemap\.xml/|sitemap\.html|sitemap_index\.xml|wp-sitemap\.xml|(post|page|product|category)-sitemap\.xml)$
  RewriteRule ^ /sitemap.xml [R=301,L]

  # Everything else the old site had and this one doesn't (store, cart, account, directories,
  # category and date archives, feeds, WordPress files): 410 Gone, so Google drops it from the index.
  RewriteRule ^(tienda|carrito|checkout|finalizar-compra|mi-cuenta|producto|product|categoria-producto|product-category|guia-de-entrenadores|guia-de-gimnasios|category|tag|author|feed|comments|wp-admin|wp-content|wp-includes|wp-json)(/.*)?$ - [G,L]
  RewriteRule ^(wp-login|xmlrpc|wp-cron)\.php$ - [G,L]
  RewriteRule ^[0-9]{4}(/[0-9]{2}(/[0-9]{2})?)?/?$ - [G,L]
  RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/[^/]+/(feed|amp)/?$ - [G,L]
</IfModule>

# Share images and the iPhone icon are exported without an extension (Next.js file conventions). Inside the
# app/(es) and app/(en) route groups the share images get a fixed suffix: opengraph-image-35z9gd.
<FilesMatch "^opengraph-image(-[a-z0-9]+)?$">
  ForceType image/jpeg
</FilesMatch>
<FilesMatch "^apple-icon$">
  ForceType image/png
</FilesMatch>
AddType application/manifest+json .webmanifest

# The charset in the Content-Type header too, not only in the <meta> tag.
AddDefaultCharset UTF-8
AddCharset UTF-8 .css .js .json .webmanifest .svg .xml .txt

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript text/javascript application/json image/svg+xml application/xml text/xml application/manifest+json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  # JS, CSS and fonts live in /_next/static with hashed filenames
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/svg+xml "access plus 1 week"
</IfModule>
